{
  "name": "magkano",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm db:migrate && pnpm --parallel --filter @magkano/api --filter @magkano/web dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @magkano/api db:generate",
    "db:migrate": "pnpm --filter @magkano/api db:migrate",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "extract": "pnpm --filter @magkano/api extract",
    "tag": "pnpm --filter @magkano/api tag",
    "seed": "pnpm --filter @magkano/api seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
