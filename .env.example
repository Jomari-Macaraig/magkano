# Postgres with pgvector. `pnpm db:up` starts it on port 5435.
DATABASE_URL=postgres://magkano:magkano@localhost:5435/magkano

# Neon only (set by its Vercel integration): the direct, unpooled URL that migrate and seed prefer.
# Leave unset locally; they fall back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# OpenAI: tagging and embeddings. Optional for running the app (search falls back to text matching).
OPENAI_API_KEY=

# Clerk publishable key for the web app (sign in / sign up in the header).
VITE_CLERK_PUBLISHABLE_KEY=

# Port for the local API server; the web dev server proxies /api to it.
API_PORT=8787
